# Run .venv/bin/python scripts/init_runtime.py to create deploy/runtime/runtime.env
# with fresh service credentials and mode 0600. Never commit secrets.
# If runtime.env already exists, update its model settings and keep its credentials.
DEMO_STATE_DIR=/home/xjx/opencode-agent-demo/var/backend
DEMO_LOCAL_DEV=1
DEMO_ORIGIN=http://100.64.0.17:18080
DEMO_MAX_ITERATIONS=5
DEMO_OPENCODE_URL=http://127.0.0.1:14096
# Required local service credentials, generated by init_runtime.py (not model API keys).
OPENCODE_SERVER_PASSWORD=
MCP_SERVICE_TOKEN=
# Model remains on server9 GPUs 0 and 1; its dedicated tailnet gateway requires a key.
DEMO_PROVIDER=local-vllm
DEMO_MODEL=qwen3.6-35b-a3b
# The launcher requires a provider-only JSON even for a built-in provider.
DEMO_PROVIDER_CONFIG=/home/xjx/opencode-agent-demo/deploy/runtime/provider.vllm-gpu01.json
# Required for public HTTPS reverse proxy; turn DEMO_LOCAL_DEV=0.
DEMO_PROXY_TOKEN=

OPENCODE_BIN=/home/xjx/opencode-agent-demo/bin/opencode
DEMO_MODEL_API_KEY=
NO_PROXY=localhost,127.0.0.1,100.64.0.6,100.64.0.17
no_proxy=localhost,127.0.0.1,100.64.0.6,100.64.0.17
