# 唯一需要编辑的部署配置。复制为 config/demo.env；不要加引号或 export。
# host 网络：127.0.0.1 就是 Linux 宿主机。必须包含 /v1。
VLLM_BASE_URL=http://127.0.0.1:4625/v1
# 必须逐字匹配 vLLM /v1/models 返回的 id（区分大小写，可能含 Qwen/ 前缀）。
VLLM_MODEL=Qwen3.8-27B
# Office attachments: bytes per file and files per message (1..20).
OFFICE_MAX_FILE_BYTES=20971520
OFFICE_MAX_ATTACHMENTS=5
# vLLM 未启用鉴权时可保持 EMPTY；已启用时填写实际密钥。
VLLM_API_KEY=EMPTY
# 应与 vLLM --max-model-len 一致或更小，且大于输出长度。
VLLM_CONTEXT=32768
VLLM_MAX_OUTPUT=8192
# 已部署服务器：内网电脑打开 http://10.70.100.220:3000。
APP_PORT=3000
APP_HOST=0.0.0.0
DEMO_ORIGIN=http://10.70.100.220:3000
# 现场确认的客户端白名单；更换现场时同步修改。
# 多个网段以逗号分隔；只允许单台电脑时使用其 IP/32。
DEMO_ALLOWED_CIDRS=10.70.0.0/17
# OpenCode 保持回环监听，仅修改其端口。
OPENCODE_PORT=14097
