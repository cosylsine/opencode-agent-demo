# 仅在现场没有可用 vLLM 时使用；不要加引号或 export。
# 本地完整模型目录，必须包含 config.json、tokenizer 和所有权重分片。
MODEL_DIR=/data/models/Qwen3.8-27B
# H100 默认使用 0、1 两张卡；GPU 必须空闲。可改为 2,3 等。
GPU_IDS=0,1
TENSOR_PARALLEL_SIZE=2
SERVE_PORT=4625
SERVED_MODEL_NAME=Qwen3.8-27B
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4
# EMPTY 与应用配置默认一致；HTTP 仅监听宿主机回环。
API_KEY=EMPTY
# H100 数据中心卡启用镜像内 CUDA 前向兼容库；最终以 gpu-check 实测为准。
VLLM_ENABLE_CUDA_COMPATIBILITY=1
# 先用 eager 降低首启编译/显存开销；性能调优时可改为 0。
ENFORCE_EAGER=1
