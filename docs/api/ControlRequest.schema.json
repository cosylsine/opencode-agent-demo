{
  "$defs": {
    "Best": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "$ref": "#/$defs/PID"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "pid",
        "metrics",
        "score"
      ],
      "title": "Best",
      "type": "object"
    },
    "Bound": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "max_delta": {
          "minimum": 0,
          "title": "Max Delta",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "max_delta"
      ],
      "title": "Bound",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "kp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bound"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ki": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bound"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kd": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bound"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parameter_bounds": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/Bound"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Bounds"
        },
        "equality_tolerance": {
          "minimum": 0,
          "title": "Equality Tolerance",
          "type": "number"
        }
      },
      "required": [
        "equality_tolerance"
      ],
      "title": "Constraints",
      "type": "object"
    },
    "HistoryItem": {
      "additionalProperties": false,
      "properties": {
        "iteration_no": {
          "title": "Iteration No",
          "type": "integer"
        },
        "candidate_pid": {
          "$ref": "#/$defs/PID"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "iteration_no",
        "candidate_pid",
        "metrics",
        "score",
        "accepted",
        "reason_code"
      ],
      "title": "HistoryItem",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "metrics_version": {
          "title": "Metrics Version",
          "type": "string"
        },
        "signed_steady_error": {
          "title": "Signed Steady Error",
          "type": "number"
        },
        "steady_state_error": {
          "title": "Steady State Error",
          "type": "number"
        },
        "iae": {
          "title": "Iae",
          "type": "number"
        },
        "overshoot_ratio": {
          "title": "Overshoot Ratio",
          "type": "number"
        },
        "pressure_std": {
          "title": "Pressure Std",
          "type": "number"
        },
        "settling_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Settling Time S"
        },
        "unavailable_reasons": {
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unavailable Reasons",
          "type": "array"
        }
      },
      "required": [
        "metrics_version",
        "signed_steady_error",
        "steady_state_error",
        "iae",
        "overshoot_ratio",
        "pressure_std",
        "settling_time_s",
        "unavailable_reasons"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "PID": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "A named numeric parameter set. kp/ki/kd remain the example's parameters.",
      "title": "PID",
      "type": "object"
    },
    "PidSnapshot": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "$ref": "#/$defs/PID"
        },
        "pid_version": {
          "title": "Pid Version",
          "type": "string"
        },
        "effective_at": {
          "title": "Effective At",
          "type": "string"
        },
        "pid_form": {
          "title": "Pid Form",
          "type": "string"
        },
        "parameter_units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Parameter Units",
          "type": "object"
        },
        "operating_condition_version": {
          "title": "Operating Condition Version",
          "type": "string"
        }
      },
      "required": [
        "pid",
        "pid_version",
        "effective_at",
        "pid_form",
        "parameter_units",
        "operating_condition_version"
      ],
      "title": "PidSnapshot",
      "type": "object"
    },
    "RuleAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "NORMAL_STABLE",
            "STEADY_HIGH",
            "STEADY_LOW",
            "EXCESSIVE_OVERSHOOT",
            "SUSTAINED_OSCILLATION",
            "SLOW_RESPONSE",
            "OPERATING_CONDITION_CHANGED",
            "DATA_ANOMALY",
            "UNCERTAIN"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "assessment",
        "reason_codes"
      ],
      "title": "RuleAssessment",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "EXAMPLE",
        "SIMULATION",
        "REAL"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "control_loop_id": {
      "title": "Control Loop Id",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "call_context_token": {
      "minLength": 16,
      "title": "Call Context Token",
      "type": "string"
    },
    "iteration_id": {
      "title": "Iteration Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "actual_pid": {
      "$ref": "#/$defs/PidSnapshot"
    },
    "current_best": {
      "$ref": "#/$defs/Best"
    },
    "observation_metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "observation_state": {
      "$ref": "#/$defs/RuleAssessment"
    },
    "observation_window_end": {
      "title": "Observation Window End",
      "type": "string"
    },
    "evaluation_context_hash": {
      "title": "Evaluation Context Hash",
      "type": "string"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "remaining_iterations": {
      "maximum": 5,
      "minimum": 0,
      "title": "Remaining Iterations",
      "type": "integer"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryItem"
      },
      "maxItems": 5,
      "title": "History",
      "type": "array"
    },
    "example_program_description": {
      "maxLength": 2000,
      "title": "Example Program Description",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "control_loop_id",
    "source_kind",
    "call_context_token",
    "iteration_id",
    "candidate_id",
    "actual_pid",
    "current_best",
    "observation_metrics",
    "observation_state",
    "observation_window_end",
    "evaluation_context_hash",
    "constraints",
    "remaining_iterations",
    "history",
    "example_program_description"
  ],
  "title": "ControlRequest",
  "type": "object"
}
