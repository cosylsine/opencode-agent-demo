{
  "name": "opencode-control-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../../docs/api/openapi.json -o src/api.generated.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dev": "vite --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
